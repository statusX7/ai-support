#!/usr/bin/env bash
set -euo pipefail

MOCK_CURL_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"

if [[ -n "${MOCK_FORBIDDEN_ARG_FILE:-}" && -f "$MOCK_FORBIDDEN_ARG_FILE" ]]; then
  while IFS= read -r forbidden || [[ -n "$forbidden" ]]; do
    [[ -n "$forbidden" ]] || continue
    if [[ " $* " == *"$forbidden"* ]]; then
      printf 'curl 测试桩拒绝命令行参数中的敏感值\n' >&2
      exit 90
    fi
  done < "$MOCK_FORBIDDEN_ARG_FILE"
fi

OUTPUT_FILE=""
WRITE_OUT=""
URL=""
FAIL_ON_HTTP=0
FORM_FILE=""
FORM_FILENAME=""
CONFIG_FILE=""
CONFIG_CONTENT=""
DATA_FILE=""
REQUEST_BODY="{}"
REQUEST_METHOD=GET
AUTH_DIGEST=""
CONFIG_INPUT_SECURE=0

while (( $# > 0 )); do
  case "$1" in
    --output|-o)
      OUTPUT_FILE=$2
      shift 2
      ;;
    --write-out|-w)
      WRITE_OUT=$2
      shift 2
      ;;
    --form|-F)
      if [[ "$2" == file=@* ]]; then
        FORM_FILE=${2#file=@}
        if [[ "$FORM_FILE" == *";filename="* ]]; then
          FORM_FILENAME=${FORM_FILE#*;filename=}
          FORM_FILE=${FORM_FILE%%;filename=*}
        fi
      fi
      shift 2
      ;;
    --config|-K)
      CONFIG_FILE=$2
      shift 2
      ;;
    --data-binary)
      if [[ "$2" == @* ]]; then
        DATA_FILE=${2#@}
      else
        REQUEST_BODY=$2
      fi
      shift 2
      ;;
    --data|--data-raw)
      REQUEST_BODY=$2
      shift 2
      ;;
    --request|-X)
      REQUEST_METHOD=$2
      shift 2
      ;;
    --header|-H|--connect-timeout|--max-time)
      shift 2
      ;;
    --fail|-f)
      FAIL_ON_HTTP=1
      shift
      ;;
    --silent|-s|--show-error|-S)
      shift
      ;;
    http://*|https://*)
      URL=$1
      shift
      ;;
    *)
      shift
      ;;
  esac
done

if [[ "$CONFIG_FILE" == "-" && "$DATA_FILE" == "-" ]]; then
  printf 'curl 测试桩拒绝认证配置与正文共用 stdin\n' >&2
  exit 2
fi
if [[ -n "$CONFIG_FILE" ]]; then
  if [[ "$CONFIG_FILE" == "-" ]]; then
    CONFIG_CONTENT=$(cat)
    CONFIG_INPUT_SECURE=1
  elif [[ "$CONFIG_FILE" =~ ^/(dev/fd|proc/self/fd)/[0-9]+$ ]] \
    && [[ -r "$CONFIG_FILE" ]] && [[ -p "$CONFIG_FILE" ]]; then
    CONFIG_CONTENT=$(cat -- "$CONFIG_FILE")
    CONFIG_INPUT_SECURE=1
  elif [[ -f "$CONFIG_FILE" && ! -L "$CONFIG_FILE" ]]; then
    CONFIG_CONTENT=$(<"$CONFIG_FILE")
    if [[ "$(stat -c '%a' -- "$CONFIG_FILE")" == 600 ]]; then
      CONFIG_INPUT_SECURE=1
    fi
  else
    printf 'curl 测试桩收到无效的 --config 输入\n' >&2
    exit 2
  fi
fi
if [[ -n "$DATA_FILE" ]]; then
  if [[ "$DATA_FILE" == "-" ]]; then
    REQUEST_BODY=$(cat)
  elif [[ -f "$DATA_FILE" ]]; then
    REQUEST_BODY=$(<"$DATA_FILE")
  fi
fi
# 认证值只在测试桩内存中解析；后续缓存夹具只接收不可逆摘要。
if [[ -n "$CONFIG_CONTENT" && "$CONFIG_INPUT_SECURE" == 1 ]]; then
  if ! AUTH_DIGEST=$(printf '%s' "$CONFIG_CONTENT" | python3 -c '
import hashlib, json, sys
headers = []
for line in sys.stdin.read().splitlines():
    key, separator, value = line.partition("=")
    if separator and key.strip() == "header":
        headers.append(json.loads(value.strip()))
values = [header[len("Authorization: Bearer "):] for header in headers
          if isinstance(header, str) and header.startswith("Authorization: Bearer ")]
if len(values) > 1 or any("\n" in value or "\r" in value or not value for value in values):
    raise SystemExit(1)
print(hashlib.sha256(values[0].encode()).hexdigest() if values else "")
'); then
    printf 'curl 测试桩收到无效的认证配置\n' >&2
    exit 2
  fi
fi

[[ -n "$URL" ]] || {
  printf 'curl 测试桩未收到 URL\n' >&2
  exit 2
}

STATUS=200
BODY='{"ok":true}'
case "$URL" in
  */models)
    if [[ "${MOCK_PROVIDER_FAIL:-0}" == 1 ]]; then
      STATUS=503
      BODY='{"error":{"message":"测试 Provider 不可用"}}'
    else
      BODY='{"data":[{"id":"gpt-vision-test"},{"id":"deepseek-test"}]}'
    fi
    ;;
  */responses)
    if [[ "${MOCK_PROVIDER_FAIL:-0}" == 1 ]]; then
      STATUS=503
      BODY='{"error":{"message":"测试 Provider 不可用"}}'
    elif [[ "${MOCK_PROVIDER_SOFT_ERROR:-0}" == 1 ]]; then
      BODY='{"error":{"message":"HTTP 200 测试错误"}}'
    elif [[ "${MOCK_PROVIDER_REASONING_MINIMUM:-0}" == 1 ]] \
      && [[ "$(jq -r '.max_output_tokens // 0' <<< "$REQUEST_BODY")" -lt 64 ]]; then
      BODY='{"status":"incomplete","incomplete_details":{"reason":"max_output_tokens"},"output":[{"type":"reasoning","status":"incomplete","content":[{"type":"reasoning_text","text":"synthetic reasoning"}]}]}'
    else
      BODY='{"id":"test-response","output":[{"type":"message","content":[{"type":"output_text","text":"OK"}]}]}'
    fi
    ;;
  */chat/completions)
    if [[ "${MOCK_PROVIDER_RESPONSES_ONLY:-0}" == 1 ]]; then
      STATUS=404
      BODY='{"error":{"message":"测试服务仅支持 Responses"}}'
    elif [[ "${MOCK_PROVIDER_FAIL:-0}" == 1 ]]; then
      STATUS=503
      BODY='{"error":{"message":"测试 Provider 不可用"}}'
    elif [[ "${MOCK_PROVIDER_SOFT_ERROR:-0}" == 1 ]]; then
      BODY='{"error":{"message":"HTTP 200 测试错误"}}'
    else
      BODY='{"id":"test-chat","choices":[{"message":{"role":"assistant","content":"OK"}}]}'
    fi
    ;;
  https://api.crisp.chat/*)
    if [[ "${MOCK_CRISP_FAIL:-0}" == 1 ]]; then
      STATUS=503
      BODY='{"error":"测试 Crisp 不可用"}'
    elif [[ "${MOCK_CRISP_SOFT_ERROR:-0}" == 1 ]]; then
      BODY=$(jq -nc --arg website "${URL##*/}" '{error:true,data:{website_id:$website}}')
    elif [[ "${MOCK_CRISP_WRONG_WEBSITE:-0}" == 1 ]]; then
      BODY='{"error":false,"data":{"website_id":"22222222-2222-4222-8222-222222222222"}}'
    else
      BODY=$(jq -nc --arg website "${URL##*/}" '{error:false,data:{website_id:$website}}')
    fi
    ;;
  */webhook/crisp-webhook|*/webhook/crisp-webhook\?key=ai-support-healthcheck-invalid)
    STATUS=401
    BODY='{"accepted":false,"reason":"Webhook 校验失败"}'
    ;;
  */api/request-token)
    BODY='{"token":"test-only-anything-jwt"}'
    ;;
  */api/system/generate-api-key)
    BODY='{"apiKey":{"secret":"test-only-generated-anything-key"}}'
    ;;
  */api/v1/auth)
    BODY='{"authenticated":true,"success":true}'
    ;;
  */api/v1/system)
    result=$(python3 - "${MOCK_ANYTHING_STATE:-}" "$AUTH_DIGEST" "$URL" "$REQUEST_METHOD" <<'PY'
import json, pathlib, sys, urllib.parse
def respond(status, value):
    print(json.dumps({"status": status, "body": value}))
    raise SystemExit(0)
try:
    state_file, digest = pathlib.Path(sys.argv[1]), sys.argv[2]
    url = urllib.parse.urlsplit(sys.argv[3])
    if sys.argv[4] != "GET":
        respond(405, {"error": "synthetic-method-not-allowed"})
    if url.scheme != "http" or url.hostname not in ("127.0.0.1", "localhost") or url.username or url.password or not url.port:
        respond(503, {"error": "synthetic-unknown-component"})
    if not sys.argv[1] or state_file.is_symlink() or not state_file.is_file():
        respond(503, {"error": "synthetic-component-not-started"})
    if len(digest) != 64 or any(character not in "0123456789abcdef" for character in digest):
        respond(401, {"error": "synthetic-authentication-failed"})
    instances = json.loads(state_file.read_text()).get("rag_instances", {})
    candidates = [entry for entry in instances.values() if entry.get("port") == url.port]
    if not candidates:
        respond(503, {"error": "synthetic-component-not-started"})
    candidates = [entry for entry in candidates if entry.get("api_key_sha256") == digest]
    if not candidates:
        respond(401, {"error": "synthetic-authentication-failed"})
    if len(candidates) != 1:
        respond(503, {"error": "synthetic-conflicting-running-state"})
    windows = [entry["context_window"] for entry in candidates]
    if any(type(window) is not int or not 256 <= window <= 2097152 for window in windows):
        raise ValueError()
    if len(set(windows)) != 1:
        respond(503, {"error": "synthetic-conflicting-running-state"})
    respond(200, {"settings": {"GenericOpenAiTokenLimit": str(windows[0])}})
except (OSError, ValueError, KeyError, TypeError, AttributeError):
    respond(503, {"error": "synthetic-invalid-running-state"})
PY
    )
    STATUS=$(jq -r '.status' <<< "$result")
    BODY=$(jq -c '.body' <<< "$result")
    ;;
  */api/v1/system/remove-documents)
    if [[ "${MOCK_REMOVE_DOCUMENTS_FAIL:-0}" == 1 ]]; then
      STATUS=503
      BODY='{"success":false,"error":"测试源文档删除失败"}'
    else
      if [[ -n "${MOCK_ANYTHING_STATE:-}" ]]; then
        [[ -f "$MOCK_ANYTHING_STATE" ]] || printf '{"documents":[]}\n' > "$MOCK_ANYTHING_STATE"
        REMOVED_DOCUMENTS=$(jq -c '.names // []' <<< "$REQUEST_BODY")
        python3 -B "${MOCK_CURL_DIR}/anything-cache.py" remove \
          "$MOCK_ANYTHING_STATE" "${MOCK_CHOWN_ROOT:?}" "$URL" "sha256:${AUTH_DIGEST}" "$REMOVED_DOCUMENTS"
      fi
      BODY='{"success":true}'
    fi
    ;;
  */api/v1/document/upload)
    if [[ -n "$FORM_FILENAME" ]]; then
      DOCUMENT_NAME=$FORM_FILENAME
    else
      DOCUMENT_NAME=$(basename -- "${FORM_FILE:-test-knowledge}")
    fi
    BODY=$(jq -cn --arg location "custom-documents/${DOCUMENT_NAME}.json" \
      '{success:true,documents:[{location:$location}]}')
    if [[ -n "${MOCK_ANYTHING_STATE:-}" ]]; then
      python3 -B "${MOCK_CURL_DIR}/anything-cache.py" upload \
        "$MOCK_ANYTHING_STATE" "${MOCK_CHOWN_ROOT:?}" "$URL" "sha256:${AUTH_DIGEST}" "$FORM_FILE" "$DOCUMENT_NAME"
    fi
    ;;
  */api/v1/workspace/*/update-embeddings)
    if [[ -n "${MOCK_ANYTHING_STATE:-}" ]]; then
      [[ -f "$MOCK_ANYTHING_STATE" ]] || printf '{"documents":[]}\n' > "$MOCK_ANYTHING_STATE"
      ADDS=$(jq -c '.adds // []' <<< "$REQUEST_BODY")
      DELETES=$(jq -c '.deletes // []' <<< "$REQUEST_BODY")
      python3 -B "${MOCK_CURL_DIR}/anything-cache.py" update \
        "$MOCK_ANYTHING_STATE" "${MOCK_CHOWN_ROOT:?}" "$URL" "sha256:${AUTH_DIGEST}" "$ADDS" "$DELETES"
    fi
    BODY='{"success":true}'
    ;;
  */api/v1/workspace/*/update)
    WORKSPACE_SLUG=${URL#*/api/v1/workspace/}
    WORKSPACE_SLUG=${WORKSPACE_SLUG%%/*}
    PROMPT=$(jq -c '.openAiPrompt // ""' <<< "$REQUEST_BODY")
    if [[ -n "${MOCK_ANYTHING_STATE:-}" ]]; then
      [[ -f "$MOCK_ANYTHING_STATE" ]] || printf '{"documents":[]}\n' > "$MOCK_ANYTHING_STATE"
      printf '%s' "$PROMPT" | python3 -B "${MOCK_CURL_DIR}/anything-cache.py" prompt-write \
        "$MOCK_ANYTHING_STATE" "${MOCK_CHOWN_ROOT:?}" "$URL" "sha256:${AUTH_DIGEST}"
    fi
    BODY=$(jq -cn --arg slug "$WORKSPACE_SLUG" --argjson prompt "$PROMPT" \
      '{workspace:{slug:$slug,openAiPrompt:$prompt,documents:[]}}')
    ;;
  */api/v1/workspace/new)
    WORKSPACE_SLUG=$(jq -r '.name // .slug // "crisp-support"' <<< "$REQUEST_BODY")
    BODY=$(jq -cn --arg slug "$WORKSPACE_SLUG" '{workspace:{slug:$slug,documents:[]}}')
    ;;
  */api/v1/workspace/*/chat)
    BODY='{"textResponse":"健康检查通过","sources":[]}'
    ;;
  */api/v1/workspace/*)
    WORKSPACE_SLUG=${URL#*/api/v1/workspace/}
    WORKSPACE_SLUG=${WORKSPACE_SLUG%%/*}
    DOCUMENTS='[]'
    PROMPT='""'
    if [[ -n "${MOCK_ANYTHING_STATE:-}" && -f "$MOCK_ANYTHING_STATE" ]]; then
      INSTANCE_WORKSPACE=$(python3 -B "${MOCK_CURL_DIR}/anything-cache.py" workspace-observe \
        "$MOCK_ANYTHING_STATE" "${MOCK_CHOWN_ROOT:?}" "$URL" "sha256:${AUTH_DIGEST}")
      DOCUMENTS=$(jq -c '[.documents[] | {docpath:.}]' <<< "$INSTANCE_WORKSPACE")
      PROMPT=$(jq -c '.prompt' <<< "$INSTANCE_WORKSPACE")
    fi
    BODY=$(jq -cn --arg slug "$WORKSPACE_SLUG" --argjson prompt "$PROMPT" --argjson documents "$DOCUMENTS" \
      '{workspace:{slug:$slug,openAiPrompt:$prompt,documents:$documents}}')
    ;;
  */healthz|*/healthz/readiness|*/api/ping)
    BODY='{"status":"ok"}'
    ;;
esac

if [[ -n "$OUTPUT_FILE" ]]; then
  printf '%s' "$BODY" > "$OUTPUT_FILE"
else
  printf '%s' "$BODY"
fi
if [[ -n "$WRITE_OUT" ]]; then
  printf '%s' "$STATUS"
fi

if (( FAIL_ON_HTTP )) && (( STATUS >= 400 )); then
  exit 22
fi
