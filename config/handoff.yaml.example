{
  "handoff": {
    "keywords": ["人工", "人工客服", "转人工", "真人", "真人客服"],
    "match_mode": "contains",
    "disable_ai": true,
    "notify_user": {
      "enabled": true
    },
    "message": "已暂停本次对话的 AI 回复，您的人工协助请求已收到。",
    "resume_after_seconds": 1800,
    "while_active": "人工客服正在接管此会话，请稍候。",
    "no_answer_message": "知识库暂时没有足够信息，请换一种方式描述问题。",
    "low_confidence_message": "当前答案可信度不足，请补充更多问题细节。",
    "failure_message": "当前自动客服暂时不可用，请稍后再试。",
    "low_confidence": {
      "require_sources": true,
      "minimum_score": 0.25
    }
  }
}
