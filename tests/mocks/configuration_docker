#!/usr/bin/env bash
set -euo pipefail

[[ ${CONFIGURATION_FIXTURE_READBACK_FAIL:-0} != 1 ]] || exit 1
fixture_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
[[ ${CONFIGURATION_FIXTURE_DEPLOY:?} == "$fixture_dir" && -f "$fixture_dir/.crisp-ai-installation" ]] || exit 64
fixture_container=feedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedfacefeedface
fixture_running="$fixture_dir/tmp/configuration-rag-running.json"
fixture_services="$fixture_dir/tmp/configuration-services-state"
fixture_compose_owned() {
  [[ $# -ge 8 && "$1" == compose && "$2" == --project-directory && "$3" == "$fixture_dir" \
    && "$4" == --env-file && "$5" == "$fixture_dir/.env" && "$6" == -f && "$7" == "$fixture_dir/docker-compose.yml" \
    && -f "$fixture_dir/docker-compose.yml" && ! -L "$fixture_dir/.env" && ! -L "$fixture_running" ]]
}

# 生产读回会在 n8n 容器内校验整期资料代，而不是仅比较投影文件 SHA。
# 生命周期夹具在宿主隔离根执行同一份契约，避免初始化和安全快照假绿。
fixture_materials_projection_readback() {
  node - "$fixture_dir" <<'NODE'
'use strict';
const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const deploy = process.argv[2];
const digest = (value) => crypto.createHash('sha256').update(value).digest('hex');
const canonical = (value) => Array.isArray(value)
  ? '[' + value.map(canonical).join(',') + ']'
  : value && typeof value === 'object'
    ? '{' + Object.keys(value).sort().map((key) => JSON.stringify(key) + ':' + canonical(value[key])).join(',') + '}'
    : JSON.stringify(value);
const regular = (file, maximum, optional = false) => {
  try {
    const stat = fs.lstatSync(file);
    if (!stat.isFile() || stat.isSymbolicLink() || stat.size < 1 || stat.size > maximum) {
      throw new Error('unsafe');
    }
    return fs.readFileSync(file);
  } catch (error) {
    if (optional && error.code === 'ENOENT') return null;
    throw error;
  }
};
const env = {};
for (const line of fs.readFileSync(path.join(deploy, '.env'), 'utf8').split(/\r?\n/)) {
  if (!line || line.startsWith('#') || !line.includes('=')) continue;
  const index = line.indexOf('=');
  const name = line.slice(0, index);
  let value = line.slice(index + 1);
  if (value.length >= 2 && value.startsWith('"') && value.endsWith('"')) {
    value = JSON.parse(value.replace(/\$\$/g, '$'));
  } else if (value.length >= 2 && value.startsWith("'") && value.endsWith("'")) {
    value = value.slice(1, -1);
  }
  if (!(name in env)) env[name] = value;
}
const projectionRaw = regular(path.join(deploy, 'config/materials-applied.json'), 16777216);
const value = JSON.parse(projectionRaw.toString('utf8'));
if (value.schema_version !== 2 || value.state !== 'applied'
  || value.configuration?.runtime?.revision !== value.revision
  || value.configuration.runtime.applied_revision !== value.revision) throw new Error('projection');
const runtime = { ...value.configuration.runtime };
delete runtime.revision;
delete runtime.applied_revision;
const embedded = { runtime, handoff: value.configuration.handoff, keyword: value.configuration.keyword,
  menu: value.configuration.menu, tags: value.configuration.tags, feedback: value.configuration.feedback };
for (const [name, item] of Object.entries(embedded)) {
  if (digest(canonical(item)) !== value.source_components?.[name]) throw new Error('component');
}
if (digest(value.prompt.text) !== value.prompt.sha256
  || Buffer.byteLength(value.prompt.text) !== value.prompt.bytes
  || value.source_components.prompt !== value.prompt.sha256) throw new Error('prompt');
if (digest(canonical(value.knowledge)) !== value.source_components.knowledge
  || digest(canonical(value.source_components)) !== value.source_sha256) throw new Error('identity');
const base = path.join(deploy, 'data/runtime');
const map = regular(path.join(base, 'knowledge-map.json'), 16777216);
const settings = regular(path.join(base, 'knowledge-settings.json'), 65536);
const lexical = regular(path.join(base, 'knowledge-lexical.json'), 16777216);
const profile = regular(path.join(base, 'knowledge-profile.json'), 65536, true);
if (digest(map) !== value.knowledge.map_sha256 || digest(settings) !== value.knowledge.settings_sha256
  || digest(lexical) !== value.knowledge.lexical_sha256
  || (profile === null ? '' : digest(profile)) !== value.knowledge.profile_sha256) {
  throw new Error('runtime knowledge');
}
const mapValue = JSON.parse(map.toString('utf8'));
const settingsValue = JSON.parse(settings.toString('utf8'));
if (mapValue?.schema_version !== 2 || !Array.isArray(mapValue.documents)
  || mapValue.documents.length !== value.knowledge.enabled_document_count) throw new Error('map count');
if (settingsValue?.schema_version !== 1
  || settingsValue.workspace_slug !== String(env.ANYTHINGLLM_WORKSPACE || 'crisp-support')
  || typeof settingsValue.temperature !== 'number' || !Number.isFinite(settingsValue.temperature)
  || settingsValue.temperature < 0 || settingsValue.temperature > 2
  || !Number.isSafeInteger(settingsValue.observed_at) || settingsValue.observed_at < 0) throw new Error('settings');
if (profile !== null) {
  const profileValue = JSON.parse(profile.toString('utf8'));
  if (profileValue?.schema_version !== 1 || profileValue.state !== 'applied'
    || !/^[a-f0-9]{64}$/.test(profileValue.fingerprint || '')
    || digest(canonical(profileValue.profile)) !== profileValue.fingerprint) throw new Error('profile');
} else if (value.knowledge.enabled_document_count > 0) throw new Error('profile missing');
process.stdout.write(digest(projectionRaw) + ':' + value.revision + ':ready');
NODE
}
if [[ $# -eq 4 && "$1" == context && "$2" == inspect && "$3" == --format && "$4" == '{{(index .Endpoints "docker").Host}}' ]]; then
  printf 'unix:///var/run/docker.sock\n'
  exit 0
fi
if [[ "${1:-}" == info ]]; then
  [[ "${CONFIGURATION_FIXTURE_DAEMON_FAIL:-0}" != 1 ]] || exit 1
  printf 'Docker daemon 测试桩可用\n'
  exit 0
fi
if [[ $# -eq 4 && "$1" == inspect && "$2" == --format && "$4" == "$fixture_container" \
  && "$3" == '{{index .Config.Labels "com.docker.compose.project.working_dir"}}|{{index .Config.Labels "com.docker.compose.service"}}' ]]; then
  printf '%s|anythingllm\n' "$fixture_dir"
  exit 0
fi
if [[ "${*:8}" == 'ps --all --quiet anythingllm' ]]; then
  fixture_compose_owned "$@" || exit 64
  printf '%s\n' "$fixture_container"
  exit 0
fi
if [[ "${*:8}" == 'up -d --no-deps --force-recreate anythingllm' ]]; then
  fixture_compose_owned "$@" || exit 64
  fixture_window=$(awk -F= '$1=="PROVIDER_RAG_CONTEXT_WINDOW" {value=substr($0,index($0,"=")+1); gsub(/[\047\042]/,"",value); print value}' "$fixture_dir/.env")
  [[ "$fixture_window" =~ ^[1-9][0-9]{2,6}$ ]] && (( fixture_window >= 256 && fixture_window <= 2097152 )) || exit 64
  fixture_recreates=0
  if [[ -f "$fixture_running" ]]; then fixture_recreates=$(jq -M -er '.recreates | select(type=="number" and floor==. and .>=0)' "$fixture_running"); fi
  fixture_temporary=$(mktemp "$fixture_dir/tmp/rag-running.XXXXXXXX")
  jq -M -n --argjson window "$fixture_window" --argjson recreates "$((fixture_recreates+1))" \
    '{context_window:$window,recreates:$recreates,service:"anythingllm",scope:"synthetic-docker-protocol"}' > "$fixture_temporary"
  chmod 600 "$fixture_temporary"
  mv -f -- "$fixture_temporary" "$fixture_running"
  exit 0
fi
if fixture_compose_owned "$@" && [[ "${8:-}" == ps && " $* " == *' --all --format json '* ]]; then
  for fixture_service in postgres anythingllm n8n provider-adapter; do
    fixture_state=running fixture_health=healthy
    if [[ -f "$fixture_services" && ! -L "$fixture_services" ]] \
      && ! grep -Fxq "$fixture_service" "$fixture_services"; then
      fixture_state=exited fixture_health=''
    fi
    [[ "${CONFIGURATION_FIXTURE_UNHEALTHY_SERVICE:-}" != "$fixture_service" ]] || fixture_health=unhealthy
    jq -cn --arg service "$fixture_service" --arg state "$fixture_state" --arg health "$fixture_health" \
      '{ID:("fixture-"+$service),Service:$service,State:$state,Health:$health,ExitCode:(if $state=="running" then 0 else 1 end)}'
  done
  exit 0
fi
# 该夹具模拟外部反代实例，受管 Caddy 不存在。生产生命周期会在启动前
# 精确查询并收敛可能遗留的本项目 Caddy；测试桩必须实现同一只读查询，
# 不能用“未实现命令”制造反向代理故障。
if fixture_compose_owned "$@" \
  && [[ " $* " == *' --profile managed-https ps --all -q caddy '* ]]; then
  exit 0
fi
if fixture_compose_owned "$@" && [[ "${8:-}" == stop ]]; then
  : > "$fixture_services"
  chmod 600 "$fixture_services"
  exit 0
fi
if fixture_compose_owned "$@" && [[ "${8:-}" == up && " $* " == *' --remove-orphans '* ]]; then
  printf '%s\n' postgres anythingllm n8n provider-adapter > "$fixture_services"
  chmod 600 "$fixture_services"
  exit 0
fi
if [[ "${8:-}" == exec && "${9:-}" == -T && "${10:-}" == anythingllm && "${11:-}" == node && "${12:-}" == -e \
  && "${13:-}" == 'process.stdout.write(String(process.env.GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT || ""))' && $# -eq 13 ]]; then
  fixture_compose_owned "$@" || exit 64
  # 独立的运行值只在上述精确重建命令后变化；不能将编辑 .env 冒充生效。
  jq -M -er '.context_window' "$fixture_running"
  exit 0
fi
if [[ "${8:-}" == exec && "${9:-}" == -T && "${10:-}" == n8n && "${11:-}" == node \
  && "${12:-}" == /opt/crisp-ai/n8n/admin-query.js && $# -eq 12 ]]; then
  fixture_compose_owned "$@" || exit 64
  fixture_request=$(mktemp "$fixture_dir/tmp/admin-query-request.XXXXXXXX")
  trap 'rm -f -- "$fixture_request"' EXIT
  chmod 600 "$fixture_request"
  cat > "$fixture_request"
  jq -M -e '.question == "电脑问题的处理标记是什么？" and
    (.budget_ms | type == "number" and floor == . and . >= 0)' "$fixture_request" >/dev/null \
    || exit 64
  jq -M -c -n --slurpfile map "$fixture_dir/data/runtime/knowledge-map.json" '
    {answer:"协议模型回答",sources:[$map[0].documents[].location],
      verified:true,retrieval_state:(if ($map[0].documents | length) > 0 then "knowledge_hit" else "knowledge_miss" end)}'
  exit 0
fi
if [[ "$*" == *" config --quiet"* || "$*" == *" up -d "* ]]; then
  exit 0
fi
if [[ "$*" == *" ps --services --filter status=running"* ]]; then
  if [[ -f "$fixture_services" && ! -L "$fixture_services" ]]; then
    cat -- "$fixture_services"
  else
    printf '%s\n' postgres anythingllm n8n provider-adapter
  fi
  exit 0
fi
if [[ $# -eq 13 && "${8:-}" == exec && "${9:-}" == -T && "${10:-}" == n8n \
  && "${11:-}" == node && "${12:-}" == -e \
  && "${13:-}" == *'/opt/crisp-ai/config/materials-applied.json'* \
  && "${13:-}" == *'crypto.createHash("sha256")'* ]]; then
  fixture_compose_owned "$@" || exit 64
  [[ -f "$fixture_dir/config/materials-applied.json" \
    && ! -L "$fixture_dir/config/materials-applied.json" ]] || exit 1
  if [[ "${13}" == *'digest(projectionRaw)+":"+value.revision+":ready"'* ]]; then
    fixture_materials_projection_readback
  else
    sha256sum -- "$fixture_dir/config/materials-applied.json" | awk '{printf "%s",$1}'
  fi
  exit 0
fi
if [[ "$*" == *"exec -T anythingllm node -e"* && "$*" == *"/chat/completions"* ]]; then
  printf '{"verified":true,"environment":"fixture","path":"/chat/completions"}'
  exit 0
fi
arguments=("$@")
last=${arguments[${#arguments[@]}-1]}
if [[ "$last" =~ ^[a-z][a-z0-9_-]*\.(yaml|md|json)$ ]]; then
  sha256sum -- "${CONFIGURATION_FIXTURE_DEPLOY:?}/config/${last}" | awk '{printf "%s",$1}'
  exit 0
fi
printf '测试桩拒绝未实现的 Docker 请求\n' >&2
exit 1
