# 部署目录；安装脚本会按选择结果写入 .env。
DEPLOY_DIR=/opt/crisp-ai

# 默认只允许本机或反向代理访问。
BIND_ADDRESS=127.0.0.1
N8N_PORT=5678
ANYTHINGLLM_PORT=3001
N8N_HOST=support.example.com
PUBLIC_WEBHOOK_URL=https://support.example.com/
WEBHOOK_PRODUCTION_URL=https://support.example.com/webhook/crisp-webhook
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true
TIMEZONE=Europe/London

# managed_https 会启用仅公开生产 Webhook 的 Caddy；external_proxy 复用现有 HTTPS 反向代理。
WEBHOOK_ACCESS_MODE=external_proxy
WEBHOOK_DOMAIN=support.example.com

# 仅为格式示例。安装时必须生成独立随机值，禁止直接用于生产。
N8N_ENCRYPTION_KEY=replace-with-a-random-encryption-key
POSTGRES_PASSWORD=replace-with-a-random-database-password
ANYTHINGLLM_AUTH_TOKEN=replace-with-a-random-login-password
ANYTHINGLLM_JWT_SECRET=replace-with-a-random-jwt-secret
ANYTHINGLLM_SIG_KEY=replace-with-a-random-signing-key
ANYTHINGLLM_SIG_SALT=replace-with-a-random-signing-salt

# OpenAI Compatible API；安装脚本会先检测模型与接口能力再写入 .env。
AI_API_BASE_URL=https://api.example.com/v1
# AnythingLLM 的受管内部协议适配地址；外部供应商地址仍使用 AI_API_BASE_URL。
AI_ANYTHINGLLM_BASE_URL=http://provider-adapter:8787/v1
AI_CUSTOM_HEADERS_JSON=
# 宿主机探测地址；Provider 在本机时，容器地址会自动改用 host.docker.internal。
AI_API_PROBE_BASE_URL=https://api.example.com/v1
AI_API_KEY=replace-with-your-api-key
AI_MODEL=replace-with-a-detected-model
AI_MODEL_TOKEN_LIMIT=8192

# AnythingLLM Developer API Key 由安装脚本在首次启动后自动创建，也可预先提供。
ANYTHINGLLM_API_KEY=replace-with-anythingllm-developer-api-key
ANYTHINGLLM_WORKSPACE=crisp-support
ANYTHINGLLM_CHAT_MODE=chat

# Crisp Token 支持 website 或 plugin tier；密钥只写入实际 .env。
CRISP_WEBSITE_ID=replace-with-crisp-website-id
CRISP_TOKEN_TIER=website
CRISP_TOKEN_IDENTIFIER=replace-with-token-identifier
CRISP_TOKEN_KEY=replace-with-token-key
CRISP_AUTH_B64=replace-with-base64-identifier-colon-key
# Website Hook 使用 URL Secret；Plugin Hook 使用 Crisp 提供的签名 Secret，两者不可混用。
CRISP_HOOK_MODE=website
CRISP_WEBSITE_HOOK_SECRET=replace-with-a-random-url-secret
CRISP_PLUGIN_SIGNING_SECRET=not-configured
# 额外允许的图片主机以逗号分隔；默认已允许 crisp.chat 子域名。
CRISP_IMAGE_HOSTS=

# Provider 能力检测结果，由安装或管理脚本维护。
AI_API_MODE=responses
AI_SUPPORTS_VISION=false
AI_MAX_OUTPUT_TOKENS=1200

# 本机回滚快照策略。0 表示不预留空间或不自动清理历史。
SNAPSHOT_MIN_FREE_MB=1024
SNAPSHOT_RETENTION_COUNT=10

# 慢速虚拟机首次启动可能需要较长时间；总秒数与轮询间隔均有安全上限。
LOCAL_HEALTH_TIMEOUT_SECONDS=1800
LOCAL_HEALTH_INTERVAL_SECONDS=5
# workflow 发布后等待 n8n JavaScript task runner 可处理生产 Webhook。
N8N_WORKFLOW_READY_TIMEOUT_SECONDS=300

# 镜像可在受控升级时覆盖。
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.33.0
POSTGRES_IMAGE=postgres:16.10-alpine
ANYTHINGLLM_IMAGE=mintplexlabs/anythingllm:1.16.1
CADDY_IMAGE=caddy:2.10.2-alpine
