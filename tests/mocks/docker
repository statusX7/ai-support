#!/usr/bin/env bash
set -euo pipefail

if [[ -n "${MOCK_DOCKER_LOG:-}" ]]; then
  printf '%s\n' "$*" >> "$MOCK_DOCKER_LOG"
fi

if [[ "${1:-}" == context ]]; then
  case "${2:-}" in
    show) printf 'default\n'; exit 0 ;;
    inspect) printf 'unix:///var/run/docker.sock\n'; exit 0 ;;
    *) printf 'docker context 测试桩不支持命令：%s\n' "$*" >&2; exit 2 ;;
  esac
fi

if [[ "${1:-}" == version ]]; then
  if [[ "$*" == *'{{.Server.Version}}'* ]]; then
    printf '24.0.0\n'
  else
    printf 'Docker version 24.0.0-test\n'
  fi
  exit 0
fi

if [[ "${1:-}" == image ]]; then
  shift
  case "${1:-}" in
    inspect)
      if [[ "$*" == *'--format'* ]]; then
        printf 'sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n'
      elif [[ "${MOCK_DOCKER_MISSING_IMAGE:-0}" == 1 ]]; then
        printf '测试桩：历史镜像不存在\n' >&2
        exit 1
      fi
      exit 0
      ;;
    tag) exit 0 ;;
    *) printf 'docker image 测试桩不支持命令：%s\n' "$*" >&2; exit 2 ;;
  esac
fi

if [[ "${1:-}" == info ]]; then
  if [[ "${MOCK_DOCKER_DAEMON_FAIL:-0}" == 1 ]]; then
    printf '无法连接测试 Docker daemon\n' >&2
    exit 1
  fi
  if [[ "$*" == *'{{.Architecture}}'* ]]; then
    case "$(uname -m)" in
      x86_64|amd64) printf 'amd64\n' ;;
      aarch64|arm64) printf 'arm64\n' ;;
      *) printf '%s\n' "$(uname -m)" ;;
    esac
  else
    printf 'Docker daemon 测试桩可用\n'
  fi
  exit 0
fi

if [[ "${1:-}" == inspect ]]; then
  if [[ "$*" == *'HostConfig.LogConfig'* ]]; then
    printf '{"Type":"json-file","Config":{"max-size":"%s","max-file":"%s"}}\n' \
      "${MOCK_LOG_MAX_SIZE:-10m}" "${MOCK_LOG_MAX_FILES:-5}"
  else
    printf '{"Running":true,"Restarting":false,"OOMKilled":false,"ExitCode":0}\n'
  fi
  exit 0
fi

if [[ "${1:-}" == run ]]; then
  [[ "${MOCK_DOCKER_FAIL_RUN:-0}" != 1 ]]
  exit
fi

if [[ "${1:-}" == container && "${2:-}" == ls ]]; then
  if [[ "${MOCK_DOCKER_REMAINING_CONTAINERS:-0}" == 1 ]]; then
    printf 'crisp-ai-test-n8n-1\n'
  fi
  exit 0
fi

if [[ "${1:-}" == network && "${2:-}" == ls ]]; then
  if [[ "${MOCK_DOCKER_REMAINING_NETWORKS:-0}" == 1 ]]; then
    printf 'crisp-ai-test_backend\n'
  fi
  exit 0
fi

[[ "${1:-}" == compose ]] || {
  printf 'docker 测试桩不支持命令：%s\n' "$*" >&2
  exit 2
}
shift

if [[ "${1:-}" == --help ]]; then
  printf '%s\n' 'Usage: docker compose [--project-directory PATH] [--env-file FILE] COMMAND'
  exit 0
fi

if [[ "${1:-}" == version ]]; then
  printf 'Docker Compose version v2.99.0-test\n'
  exit 0
fi

MOCK_PROJECT_DIR=''
while (( $# > 0 )); do
  case "$1" in
    --project-directory)
      MOCK_PROJECT_DIR=$2
      shift 2
      ;;
    --env-file|-f|--profile)
      shift 2
      ;;
    *)
      break
      ;;
  esac
done

mock_anything_runtime() {
  local action=$1
  shift || true
  if [[ -z "${MOCK_ANYTHING_STATE:-}" ]]; then
    [[ "$action" == capture ]]
    return
  fi
  python3 - "$MOCK_ANYTHING_STATE" "$MOCK_PROJECT_DIR" "$action" "$@" <<'PY'
import hashlib, json, os, pathlib, re, stat, sys, tempfile
try:
    state_file, project, action = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2]), sys.argv[3]
    if not project.is_absolute() or project.is_symlink() or state_file.is_symlink():
        raise ValueError()
    if state_file.exists() and not stat.S_ISREG(state_file.stat().st_mode):
        raise ValueError()
    state = json.loads(state_file.read_text()) if state_file.exists() else {"documents": []}
    instances = state.setdefault("rag_instances", {})
    if action == "capture":
        env_file = project / ".env"
        if env_file.is_symlink() or not env_file.is_file():
            raise ValueError()
        values = {}
        for line in env_file.read_text().splitlines():
            name, separator, value = line.partition("=")
            if separator and name in ("PROVIDER_RAG_CONTEXT_WINDOW", "AI_MODEL_TOKEN_LIMIT", "ANYTHINGLLM_PORT", "ANYTHINGLLM_API_KEY", "KNOWLEDGE_ACTIVE_EMBEDDING_MODEL"):
                if len(value) >= 2 and value.startswith('"') and value.endswith('"'):
                    value = json.loads(value.replace("$$", "$"))
                elif len(value) >= 2 and value.startswith("'") and value.endswith("'"):
                    value = value[1:-1]
                values.setdefault(name, value)
        window = int(values.get("PROVIDER_RAG_CONTEXT_WINDOW", values.get("AI_MODEL_TOKEN_LIMIT", "8192")))
        port, key = int(values.get("ANYTHINGLLM_PORT", "3001")), values.get("ANYTHINGLLM_API_KEY", "")
        if not 256 <= window <= 2097152 or not 1 <= port <= 65535 or not key:
            raise ValueError()
        previous = instances.get(str(project), {})
        document_root = project / "data/anythingllm/documents/custom-documents"
        documents = []
        if document_root.exists():
            if document_root.is_symlink() or not document_root.is_dir():
                raise ValueError()
            for document in document_root.iterdir():
                info = document.lstat()
                if not document.is_file() or document.is_symlink() or info.st_nlink != 1 \
                        or not document.name.endswith(".json"):
                    raise ValueError()
                documents.append("custom-documents/" + document.name)
        instances[str(project)] = {
            "context_window": window,
            "port": port,
            "api_key_sha256": hashlib.sha256(key.encode()).hexdigest(),
            "knowledge_model": values.get("KNOWLEDGE_ACTIVE_EMBEDDING_MODEL")
                               or previous.get("knowledge_model")
                               or "Xenova/all-MiniLM-L6-v2",
            "knowledge_chunk_size": previous.get("knowledge_chunk_size", 1000),
            "knowledge_chunk_overlap": previous.get("knowledge_chunk_overlap", 20),
            "knowledge_chunk_explicit": previous.get("knowledge_chunk_explicit", False),
            "documents": sorted(documents),
            "removed_documents": previous.get("removed_documents", []),
        }
        descriptor, temporary = tempfile.mkstemp(prefix=".mock-anything-", dir=state_file.parent)
        with os.fdopen(descriptor, "w") as stream:
            json.dump(state, stream)
        os.replace(temporary, state_file)
    elif action == "read":
        value = instances[str(project)]["context_window"]
        if type(value) is not int or not 256 <= value <= 2097152:
            raise ValueError()
        print(value)
    elif action in ("knowledge-observe", "knowledge-probe", "knowledge-configure-chunks"):
        workspace = sys.argv[4]
        if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", workspace):
            raise ValueError()
        instance = instances[str(project)]
        model = instance["knowledge_model"]
        maximum = {
            "Xenova/all-MiniLM-L6-v2": 1000,
            "Xenova/nomic-embed-text-v1": 16000,
            "MintplexLabs/multilingual-e5-small": 512,
        }.get(model)
        if maximum is None:
            raise ValueError()
        if action == "knowledge-configure-chunks":
            size, overlap = int(sys.argv[5]), int(sys.argv[6])
            if not 1 <= size <= maximum or not 0 <= overlap < size:
                raise ValueError()
            instance["knowledge_chunk_size"] = size
            instance["knowledge_chunk_overlap"] = overlap
            instance["knowledge_chunk_explicit"] = True
            descriptor, temporary = tempfile.mkstemp(prefix=".mock-anything-", dir=state_file.parent)
            with os.fdopen(descriptor, "w") as stream:
                json.dump(state, stream)
            os.replace(temporary, state_file)
        documents = instance.get("documents", [])
        if not isinstance(documents, list):
            raise ValueError()
        result = {
            "engine": "native",
            "model": model,
            "explicit_model": False,
            "chunk_size": instance["knowledge_chunk_size"],
            "chunk_overlap": instance["knowledge_chunk_overlap"],
            "explicit_chunk_size": instance["knowledge_chunk_explicit"],
            "passage_prefix": "passage: " if model == "MintplexLabs/multilingual-e5-small" else "",
            "query_prefix": "query: " if model == "MintplexLabs/multilingual-e5-small" else "",
            "component_version": "1.16.1",
            "foreign_documents": 0,
            "workspace_documents": len(documents),
            "workspace_exists": True,
        }
        if action == "knowledge-probe":
            result["probe_dimensions"] = 3
        print(json.dumps(result, separators=(",", ":")))
    else:
        raise ValueError()
except (OSError, ValueError, KeyError, TypeError):
    print("生命周期桩未取得受管 AnythingLLM 运行窗口。", file=sys.stderr)
    sys.exit(1)
PY
}

mock_provider_status() {
  local configuration_state=applied
  [[ "${MOCK_ADAPTER_STATUS_FAIL:-0}" != 1 ]] || return 1
  if [[ -e "${MOCK_PROJECT_DIR}/config/provider-pool-transaction.json" \
    || -L "${MOCK_PROJECT_DIR}/config/provider-pool-transaction.json" ]]; then
    configuration_state=applying
  fi
  python3 "${MOCK_PROJECT_DIR}/scripts/provider-pool.py" --deploy-dir "$MOCK_PROJECT_DIR" list \
    | jq --arg state "$configuration_state" '{ok,revision,configuration_state:$state,pool_cooldown_until:0,
        entries:[.entries[] | {id,enabled,health:(if .enabled then "unknown" else "disabled" end),
          cooldown_until:0,last_error:"",vision_health:(if .enabled and .capabilities.vision then "unknown" else "disabled" end),
          vision_cooldown_until:0,vision_last_error:""}]}'
}

COMMAND=${1:-}
shift || true
if [[ "${MOCK_DOCKER_FAIL_IMPORT:-0}" == 1 && "$COMMAND" == exec && "$*" == *'import:workflow'* ]]; then
  exit 1
fi
case "$COMMAND" in
  config)
    if [[ "$*" == *'--images'* ]]; then
      printf 'postgres:16.10-alpine\nmintplexlabs/anythingllm:1.16.1\ndocker.n8n.io/n8nio/n8n:2.33.0\n'
    elif [[ "$*" == *'--services'* ]]; then
      printf 'postgres\nanythingllm\nn8n\n'
      if [[ -f "${MOCK_PROJECT_DIR}/docker-compose.yml" ]] \
        && grep -Eq '^  provider-adapter:' "${MOCK_PROJECT_DIR}/docker-compose.yml"; then
        printf 'provider-adapter\n'
      fi
    elif [[ "$*" == *'--format json'* ]]; then
      printf '{"name":"crisp-ai-test"}\n'
    fi
    exit 0
    ;;
  pull)
    [[ "${MOCK_DOCKER_FAIL_PULL:-0}" != 1 ]]
    ;;
  down)
    [[ "${MOCK_DOCKER_FAIL_DOWN:-0}" != 1 ]]
    ;;
  up|stop|restart)
    if [[ " $* " == *' --help '* ]]; then
      printf 'Usage: docker compose %s [OPTIONS] [SERVICE...]\n' "$COMMAND"
      exit 0
    fi
    # 可选的独立实例运行状态，避免快照 ps 把刚停止的服务误报为仍运行。
    if [[ -n "${MOCK_DOCKER_SERVICE_STATE:-}" ]]; then
      [[ -f "$MOCK_DOCKER_SERVICE_STATE" && ! -L "$MOCK_DOCKER_SERVICE_STATE" ]] || exit 2
      services=()
      for argument in "$@"; do
        case "$argument" in
          postgres|anythingllm|n8n|provider-adapter) services+=("$argument") ;;
        esac
      done
      (( ${#services[@]} )) || services=(postgres anythingllm n8n provider-adapter)
      state_temporary=$(mktemp "${MOCK_DOCKER_SERVICE_STATE}.tmp.XXXXXX")
      cp -- "$MOCK_DOCKER_SERVICE_STATE" "$state_temporary"
      if [[ "$COMMAND" == stop ]]; then
        for service in "${services[@]}"; do
          next_state=$(mktemp "${MOCK_DOCKER_SERVICE_STATE}.next.XXXXXX")
          awk -v service="$service" '$0 != service' "$state_temporary" > "$next_state"
          mv -f -- "$next_state" "$state_temporary"
        done
      else
        printf '%s\n' "${services[@]}" >> "$state_temporary"
        sort -u -o "$state_temporary" "$state_temporary"
      fi
      chmod 600 "$state_temporary"
      mv -f -- "$state_temporary" "$MOCK_DOCKER_SERVICE_STATE"
    fi
    if [[ "$COMMAND" == up ]]; then
      runtime_services=()
      for argument in "$@"; do
        case "$argument" in postgres|anythingllm|n8n|provider-adapter|caddy) runtime_services+=("$argument") ;; esac
      done
      if (( ${#runtime_services[@]} == 0 )) || [[ " ${runtime_services[*]} " == *' anythingllm '* ]]; then
        # 独立运行值只由 Compose up/recreate 更新；restart 与只编辑 .env 均不生效。
        mock_anything_runtime capture
      fi
    fi
    exit 0
    ;;
  ps)
    if [[ " $* " == *' -q '* ]]; then
      service=${!#}
      [[ "$service" != caddy ]] || exit 0
      [[ "${MOCK_DOCKER_NO_RUNNING:-0}" != 1 ]] || exit 0
      if [[ -n "${MOCK_DOCKER_SERVICE_STATE:-}" ]]; then
        [[ -f "$MOCK_DOCKER_SERVICE_STATE" && ! -L "$MOCK_DOCKER_SERVICE_STATE" ]] || exit 2
        grep -Fxq -- "$service" "$MOCK_DOCKER_SERVICE_STATE" || exit 0
      fi
      printf 'mock-%s\n' "$service"
      exit 0
    fi
    if [[ " $* " == *' --format json '* ]]; then
      requested_services=()
      for argument in "$@"; do
        case "$argument" in postgres|anythingllm|n8n|provider-adapter|caddy) requested_services+=("$argument") ;; esac
      done
      (( ${#requested_services[@]} )) || requested_services=(postgres anythingllm n8n provider-adapter)
      for service in "${requested_services[@]}"; do
        state=running
        if [[ "${MOCK_DOCKER_NO_RUNNING:-0}" == 1 ]]; then
          state=exited
        elif [[ -n "${MOCK_DOCKER_SERVICE_STATE:-}" ]]; then
          [[ -f "$MOCK_DOCKER_SERVICE_STATE" && ! -L "$MOCK_DOCKER_SERVICE_STATE" ]] || exit 2
          grep -Fxq -- "$service" "$MOCK_DOCKER_SERVICE_STATE" || state=exited
        fi
        if [[ "$state" == running ]]; then
          health=healthy
          [[ "${MOCK_DOCKER_UNHEALTHY_SERVICE:-}" != "$service" ]] || health=unhealthy
          jq -cn --arg service "$service" --arg health "$health" \
            '{ID:("mock-"+$service),Service:$service,State:"running",Health:$health,ExitCode:0}'
        else
          jq -cn --arg service "$service" '{ID:("mock-"+$service),Service:$service,State:"exited",Health:"",ExitCode:1}'
        fi
      done
      exit 0
    fi
    if [[ "${MOCK_DOCKER_NO_RUNNING:-0}" != 1 ]]; then
      if [[ -n "${MOCK_DOCKER_SERVICE_STATE:-}" ]]; then
        [[ -f "$MOCK_DOCKER_SERVICE_STATE" && ! -L "$MOCK_DOCKER_SERVICE_STATE" ]] || exit 2
        sed -n 'p' "$MOCK_DOCKER_SERVICE_STATE"
      else
        printf 'postgres\nanythingllm\nn8n\n'
      fi
    fi
    ;;
  exec)
    if [[ "${1:-}" == -T && "${2:-}" == anythingllm && "${3:-}" == node && "${4:-}" == - \
      && "${5:-}" =~ ^(observe|probe|configure-chunks)$ ]]; then
      mock_anything_runtime "knowledge-${5}" "${6:-}" "${7:-}" "${8:-}"
    elif [[ "$*" == *' anythingllm '* && "$*" == *'CRISPAI_EXPECTED_RAG_CONTEXT'* ]]; then
      expected=''
      IFS= read -r expected || [[ -n "$expected" ]]
      [[ "$expected" =~ ^[1-9][0-9]{2,6}$ && "${MOCK_RAG_CONTEXT_MISMATCH:-0}" != 1 ]] || exit 1
      actual=$(mock_anything_runtime read)
      [[ "$actual" == "$expected" ]] || exit 1
      printf 'matched\n'
    elif [[ "$*" == *' anythingllm '* && "${!#}" == 'process.stdout.write(String(process.env.GENERIC_OPEN_AI_MODEL_TOKEN_LIMIT || ""))' ]]; then
      mock_anything_runtime read
    elif [[ "$*" == *'CRISPAI_EXPECTED_FILE_BINDING_PROVIDER'* || "$*" == *'CRISPAI_EXPECTED_FILE_BINDING_CADDY'* \
      || "$*" == *'CRISPAI_EXPECTED_FILE_BINDING_ROUTER'* || "$*" == *'CRISPAI_EXPECTED_FILE_BINDING_ENVELOPE'* ]]; then
      expected=''
      IFS= read -r expected || [[ -n "$expected" ]]
      if [[ "$*" == *'CRISPAI_EXPECTED_FILE_BINDING_PROVIDER'* ]]; then
        binding_file="${MOCK_PROJECT_DIR}/scripts/provider-adapter.js"
      elif [[ "$*" == *'CRISPAI_EXPECTED_FILE_BINDING_ROUTER'* ]]; then
        binding_file="${MOCK_PROJECT_DIR}/scripts/provider-router.js"
      elif [[ "$*" == *'CRISPAI_EXPECTED_FILE_BINDING_ENVELOPE'* ]]; then
        binding_file="${MOCK_PROJECT_DIR}/scripts/provider-envelope.js"
      else
        binding_file="${MOCK_PROJECT_DIR}/config/Caddyfile"
      fi
      [[ -f "$binding_file" && ! -L "$binding_file" && "$expected" =~ ^[a-f0-9]{64}$ ]] || exit 1
      actual=$(sha256sum -- "$binding_file"); actual=${actual%% *}
      [[ "$actual" == "$expected" && "${MOCK_FILE_BINDING_MISMATCH:-0}" != 1 ]] || exit 1
      printf 'matched\n'
    elif [[ "$*" == *' anythingllm '* && "$*" == *'/internal/provider/status'* ]]; then
      mock_provider_status
    elif [[ "$*" == *' provider-adapter '* && "$*" == *'127.0.0.1:8787'* ]]; then
      # 生命周期仅模拟受管容器控制通道；真实路由另由 HTTP 协议及 VM 测试覆盖。
      payload=$(jq -c '.')
      route=$(jq -r '.route' <<< "$payload")
      case "$route" in
        /internal/provider/status)
          [[ "$(jq -r '.method' <<< "$payload")" == GET ]] || exit 2
          mock_provider_status
          ;;
        /internal/provider/probe)
          jq -e '.method=="POST" and (.payload.api_key|type=="string" and length>0) and
            (.payload.provider.model|type=="string" and length>0) and
            (.payload.provider.api_mode=="responses" or .payload.provider.api_mode=="chat_completions")' <<< "$payload" >/dev/null || exit 2
          [[ "${MOCK_PROVIDER_FAIL:-0}" != 1 && "${MOCK_PROVIDER_SOFT_ERROR:-0}" != 1 ]] || exit 1
          jq '{ok:true,verified:true,api_mode:.payload.provider.api_mode,capabilities:{chat_completions:(.payload.provider.api_mode=="chat_completions"),responses:(.payload.provider.api_mode=="responses"),vision:(.payload.vision==true)}}' <<< "$payload"
          ;;
        *) printf '测试桩拒绝未实现的接口池管理操作\n' >&2; exit 2 ;;
      esac
    elif [[ "$*" == *'n8n --version'* ]]; then
      printf '2.99.0-test\n'
    elif [[ "$*" == *'pg_dump'* ]]; then
      [[ "${MOCK_DOCKER_FAIL_PG_DUMP:-0}" != 1 ]] || exit 1
      printf 'PGDMP-test-only-logical-backup\n'
    elif [[ "$*" == *'pg_restore'* ]]; then
      [[ "${MOCK_DOCKER_FAIL_PG_RESTORE:-0}" != 1 ]] || exit 1
    elif [[ "$*" == *'psql'* && "$*" == *'\password'* ]]; then
      IFS= read -r restore_password_first
      IFS= read -r restore_password_second
      [[ -n "$restore_password_first" && "$restore_password_first" == "$restore_password_second" ]] || exit 1
      if [[ -n "${MOCK_POSTGRES_PASSWORD_DIGEST_FILE:-}" ]]; then
        printf '%s' "$restore_password_first" | sha256sum | cut -d ' ' -f 1 > "$MOCK_POSTGRES_PASSWORD_DIGEST_FILE"
        chmod 600 "$MOCK_POSTGRES_PASSWORD_DIGEST_FILE"
      fi
      unset restore_password_first restore_password_second
      [[ "${MOCK_DOCKER_FAIL_PG_PASSWORD:-0}" != 1 ]] || exit 1
    elif [[ "$*" == *' postgres '* && "$*" == *'SELECT 1'* ]]; then
      IFS= read -r managed_user
      IFS= read -r managed_db
      IFS= read -r managed_password
      [[ "$managed_user" == crisp_ai && "$managed_db" == n8n && -n "$managed_password" ]] || exit 1
      printf '1\n'
    elif [[ "$*" == *' n8n '* && "$*" == *'DB_POSTGRESDB_PASSWORD'* ]]; then
      IFS= read -r managed_user
      IFS= read -r managed_db
      IFS= read -r managed_password
      [[ "$managed_user" == crisp_ai && "$managed_db" == n8n && -n "$managed_password" ]] || exit 1
      printf 'matched\n'
    elif [[ "$*" == *'CRISPAI_EXPECTED_ENV_BINDING'* ]]; then
      # 专项 fixture 验证旧代差异；主回归桩只证明安全 stdin/固定输出调用契约。
      expected=$(python3 -c 'import sys; values=sys.stdin.buffer.read().split(b"\0"); print(len(values)-1 if values and values[-1]==b"" else len(values))')
      [[ "$expected" =~ ^[1-9][0-9]*$ ]] || exit 1
      printf 'matched\n'
    elif [[ "$*" == *'CRISPAI_EXPECTED_MATERIALS_PROJECTION'* ]]; then
      expected=''
      IFS= read -r expected || [[ -n "$expected" ]]
      actual=$(sha256sum -- "${MOCK_PROJECT_DIR}/config/materials-applied.json" | cut -d ' ' -f 1)
      [[ "$expected" =~ ^[a-f0-9]{64}$ && "$actual" == "$expected" && "${MOCK_CONFIGURATION_READBACK_FAIL:-0}" != 1 ]] || exit 1
      printf 'matched\n'
    elif [[ "$*" == *'EXECUTIONS_DATA_PRUNE'* && "$*" == *'save_success:'* ]]; then
      jq -cn --arg hours "${MOCK_LOG_RETENTION_HOURS:-168}" \
        '{prune:"true",max_age_hours:$hours,save_success:"none",save_error:"none"}'
    elif [[ "$*" == *' anythingllm '* && "$*" == *'provider-adapter:8787/healthz'* ]]; then
      printf 'ready\n'
    elif [[ "$*" == *' n8n '* && "$*" == *'/opt/crisp-ai/config/materials-applied.json'* && "$*" == *'crypto.createHash("sha256")'* ]]; then
      [[ -f "${MOCK_PROJECT_DIR}/config/materials-applied.json" && ! -L "${MOCK_PROJECT_DIR}/config/materials-applied.json" ]] || exit 1
      [[ "${MOCK_CONFIGURATION_READBACK_FAIL:-0}" != 1 ]] || exit 1
      sha256sum -- "${MOCK_PROJECT_DIR}/config/materials-applied.json" | cut -d ' ' -f 1
    elif [[ "$*" == *'crypto.createHash("sha256")'* && "$*" == *'/opt/crisp-ai/config/'* ]]; then
      CONFIG_NAME=${!#}
      [[ "$CONFIG_NAME" =~ ^[a-z][a-z0-9_-]*\.(yaml|md)$ && -f "${MOCK_PROJECT_DIR}/config/${CONFIG_NAME}" ]] || exit 1
      [[ "${MOCK_CONFIGURATION_READBACK_FAIL:-0}" != 1 ]] || exit 1
      sha256sum -- "${MOCK_PROJECT_DIR}/config/${CONFIG_NAME}" | cut -d ' ' -f 1
    elif [[ "$*" == *'GENERIC_OPEN_AI_BASE_PATH'* && "$*" == *'fetch('* ]]; then
      [[ -f "${MOCK_PROJECT_DIR}/.env" && "${MOCK_PROVIDER_FAIL:-0}" != 1 && "${MOCK_PROVIDER_SOFT_ERROR:-0}" != 1 ]] || exit 1
      jq -e '.provider | (.api_mode == "chat_completions" or .api_mode == "responses") and (.model | length > 0)' "${MOCK_PROJECT_DIR}/config/provider.yaml" >/dev/null || exit 1
      printf '{"verified":true,"environment":"unit-docker-stub","path":"/chat/completions"}\n'
    elif [[ "$*" == *'import:workflow'* ]]; then
      [[ -f "${MOCK_PROJECT_DIR}/n8n/workflow.json" ]] || exit 1
      jq -e '.nodes | length > 0' "${MOCK_PROJECT_DIR}/n8n/workflow.json" >/dev/null || exit 1
      : > "${MOCK_PROJECT_DIR}/tmp/mock-workflow-imported"
    elif [[ "$*" == *'publish:workflow'* ]]; then
      [[ -f "${MOCK_PROJECT_DIR}/tmp/mock-workflow-imported" ]] || exit 1
      : > "${MOCK_PROJECT_DIR}/tmp/mock-workflow-active"
    elif [[ "$*" == *'export:workflow'* ]]; then
      [[ -f "${MOCK_PROJECT_DIR}/tmp/mock-workflow-active" ]] || exit 1
      [[ "$*" != *'crispai-doctor-workflow'* ]] || printf 'verified\n'
    else
      printf 'docker compose exec 测试桩未实现该调用，不返回假成功。\n' >&2
      exit 2
    fi
    ;;
  logs)
    printf '测试日志：未连接真实服务。\n'
    ;;
  *)
    printf 'docker compose 测试桩不支持命令：%s\n' "$COMMAND" >&2
    exit 2
    ;;
esac
